      },
      "db_query_outline": "SELECT jng_biz_crtr_yr, post_total_count, completed_at FROM ftc_ingestion_audit_logs WHERE status = 'COMPLETED' ORDER BY jng_biz_crtr_yr DESC LIMIT 1;",
