# ==============================================================================
# Franchise Dashboard - Production Environment Configuration Template
# 위치: /opt/franchise-dashboard/.env.production
# 주의: 이 파일은 실제 비밀정보를 포함하지 않는 공개 템플릿입니다.
# ==============================================================================

# 실행 환경 모드 (production / development)
ENVIRONMENT=production

# 프론트엔드 빌드 타임 API URL
# - 동일 출처(단일 서버 + Reverse Proxy) 배포 시: 빈 값("") 권장 (상대 경로 /api/... 로 자동 요청)
# - 프론트엔드/백엔드 분리 도메인 배포 시: 백엔드 공개 HTTPS URL (예: https://api.example.com)
VITE_API_URL=

# 백엔드 CORS 정책 (교차 출처 접근 제어)
# - 동일 출처 운영 시 (기본값): 비워둠 (""). 외부 교차 출처 요청은 브라우저에서 전면 차단됩니다.
# - 별도 프론트엔드 도메인 허용 시: 쉼표 구분 허용 도메인 명시 (예: https://dashboard.example.com)
CORS_ORIGINS=

# 서버 내부 바인딩 주소 및 포트 (systemd uvicorn 내부 루프백 바인딩)
HOST=127.0.0.1
PORT=8000

# 로깅 레벨 (INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 데이터베이스 디렉터리 구조 안내:
# 백엔드 API는 /opt/franchise-dashboard/data 디렉터리 내 아래 3개 SQLite 파일을 읽기 전용(mode=ro)으로 직접 참조합니다:
# 1) data/franchise_analytics_v1.sqlite3 (전국 73.5만 점포 및 시도/시군구 분석 통계 DB)
# 2) data/ftc_macro_statistics_v1.sqlite3 (공정거래위원회 4개년 거시통계 DB)
# 3) data/brand_master_v1.sqlite3 (5,063개 브랜드 마스터 및 대사 DB)

# 공공데이터 수집 전용 키 (대시보드 단순 조회 서비스에는 불필요하여 저장소 및 배포 파일에서 배제됨)
# SERVICE_KEY=
